# Copy to .env (gitignored). Relative paths resolve against the repo root.
# Model cache lives outside the repo. Use HF_HOME only: setting
# SENTENCE_TRANSFORMERS_HOME makes sentence-transformers look in a separate cache.
HF_HOME=../models/hf
HF_HUB_DISABLE_SYMLINKS_WARNING=1
# Config file to load (configs/local.yaml is gitignored)
TVRAG_CONFIG=configs/local.yaml
